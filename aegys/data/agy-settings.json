{
  "_comment": "Keys merged into ~/.gemini/antigravity-cli/settings.json by scripts/install.sh --apply-agy-config. See AGENTS.md.",
  "agentMode": "accept-edits",
  "altScreenMode": "always",
  "queuedMessages": "send-immediately",
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.agents/bin/agy-statusline\"",
    "enabled": true,
    "stack_with_default": true
  },
  "permissions": {
    "allow": [
      "read_file($HOME)",
      "write_file($HOME)",
      "command(gh auth status)",
      "command(gh pr view)",
      "command(gh pr list)",
      "command(gh pr diff)",
      "command(gh pr checks)",
      "command(gh pr status)",
      "command(gh pr comment)",
      "command(gh issue view)",
      "command(gh issue create)",
      "command(gh issue list)",
      "command(gh issue status)",
      "command(gh repo view)",
      "command(gh repo list)",
      "command(gh run list)",
      "command(gh run view)",
      "command(gh release list)",
      "command(gh release view)",
      "command(gh workflow list)",
      "command(gh workflow view)",
      "command(gh search)",
      "command(ls)",
      "command(firecrawl)",
      "command(git status)",
      "command(git log)",
      "command(git show)",
      "command(git diff)",
      "command(git add)",
      "command(git commit)",
      "command(git blame)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(git ls-tree)",
      "command(git cat-file)",
      "command(git describe)",
      "command(git shortlog)",
      "command(git rev-list)",
      "command(git merge-base)",
      "command(git name-rev)",
      "command(git for-each-ref)",
      "command(git check-ignore)",
      "command(git branch --show-current)",
      "command(git config --get)",
      "command(git config --list)",
      "command(git reflog show)",
      "command(git remote show)",
      "command(git stash list)",
      "command(git tag --list)",
      "command(git worktree list)",
      "command(git --version)",
      "command(df)",
      "command(free)",
      "command(hostname)",
      "command(id)",
      "command(nproc)",
      "command(uptime)",
      "command(realpath)",
      "command(gh --version)",
      "command(python3 --version)",
      "command(node --version)",
      "command(npm --version)",
      "command(julia --version)",
      "command(uv --version)",
      "command(cargo --version)",
      "command(rustc --version)",
      "command(gcc --version)",
      "command(make --version)",
      "command(npm view)",
      "command(npm search)",
      "command(base64)",
      "command(strings)",
      "command(cmp)",
      "command(pgrep)",
      "command(pdfinfo)",
      "command(mktemp)",
      "command(cargo test)",
      "command(cargo clippy)",
      "command(cargo fmt)",
      "command(orca tab list)",
      "command(orca tab show)",
      "command(orca tab current)",
      "command(orca terminal list)",
      "command(orca terminal show)",
      "command(orca snapshot)",
      "command(git push)",
      "read_url(github.com)",
      "read_url(githubusercontent.com)",
      "read_url(pypi.org)",
      "read_url(pythonhosted.org)",
      "read_url(npmjs.org)",
      "read_url(crates.io)",
      "read_url(julialang.org)",
      "command(gh pr create)",
      "command(regex:bash tests/.*)",
      "command(regex:python3 tests/.*)",
      "command(regex:(?s).*)"
    ],
    "deny": [
      "command(git push --force)",
      "command(git reset --hard)",
      "command(git clean)",
      "command(gh repo delete)",
      "command(regex:git push (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))",
      "command(regex:git push .* (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))",
      "command(regex:git push .* .* (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))",
      "command(regex:git push .* .* .* (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))",
      "command(regex:git push .* .* .* .* (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))",
      "command(regex:git push .* .* .* .* .* (--force.*|--delete.*|--mirror.*|-[a-zA-Z]*[fd][a-zA-Z]*|[+].*|:.+))"
    ]
  }
}
